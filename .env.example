# Copy to .env and fill in real values. .env is gitignored — never commit it.
# On Replit these come from Replit Secrets / .replit-artifact instead.

# --- Supabase (external project; the source of truth for all app data) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- API server port. The web app defaults to 20699 and proxies /api here. ---
PORT=8080
